#!/usr/bin/env bun
// Stands in for yt-dlp in bot.e2e.test.ts: -J describes the link (one with
// "long" in it is a 50-minute video, one with "slow" takes 3 s to describe,
// one with "fail" is unavailable, one with "tweet" is a tweet without a video,
// one with "reel" in it is an Instagram reel and one with "stream" in it a
// stream, neither saying how long it is; the video's id is the v= parameter),
// a download copies FAKE_MP4 after a while
// (one with "crawl" in it takes 9 s, with 2 MB of it on disk meanwhile; one
// with "broken" in it stops partway, 3 MB in; one with "huge" in it stops 3 MB
// in without a word, as at --max-filesize; one with "expired" in it fails after
// 4 s from saved info, as an expired media link would, and crawls from the
// page; one with "ffmpeg" in it, 2 MB in, waits 20 s for a child that has its
// stdout and stderr, as yt-dlp waits for the ffmpeg it hands m3u8 to, a child
// that ignores SIGTERM when "stubborn" is in it too; one with "linger" in it
// leaves a process in its group that doesn't hold its output and outlives it
// by 15 s, writing "up", then "done" or "TERM" if it got SIGTERM, to
// $LINGER/<id>.<its pid>; one with "endless" in it, as an HLS stream of
// unknown size, starts a 20 s child that has its stdout and stderr (as
// ffmpeg would), has 2 MB, then after 0.5 s 2001 MB (a sparse file), and is
// done with that file when the child is; with $LINGER set it also leaves a
// process in its group that ignores SIGTERM, doesn't hold its output and
// writes "up", then "done" 7 s later, to $LINGER/<id>.<its pid>; one with
// "parts" in it has a merge on disk for 1 s, 1900 and 100 MB parts and their
// 2000 MB merged copy, v.temp.mp4 at first and v.mp4 from 0.5 s on, as a
// merge renames it before the parts go)
import { copyFileSync, readFileSync, renameSync, rmSync, truncateSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'

const args = process.argv.slice(2)
if (args.includes('--update-to') || args.includes('--list-extractors')) process.exit(0)
const info = args.indexOf('--load-info-json')
const url: string =
  info >= 0
    ? JSON.parse(readFileSync(args[info + 1]!, 'utf8')).webpage_url
    : args.findLast((a) => a.startsWith('https://'))!
const long = url.includes('long')
const reel = url.includes('reel')
const lengthless = reel || url.includes('stream')
if (args.includes('-J') && url.includes('fail')) {
  console.error('ERROR: [youtube] x: Video unavailable')
  process.exit(1)
}
if (args.includes('-J') && url.includes('tweet')) {
  console.error('ERROR: [twitter] 123: No video could be found in this tweet')
  process.exit(1)
}
const expired = url.includes('expired')
const crawl = url.includes('crawl') || (expired && info < 0)
if (args.includes('-J') && url.includes('slow')) await Bun.sleep(3000)
if (args.includes('-J'))
  console.log(
    JSON.stringify({
      id: new URL(url).searchParams.get('v'),
      extractor_key: reel ? 'Instagram' : 'Youtube',
      title: 'Video',
      webpage_url: url,
      duration: lengthless ? undefined : long ? 3000 : 30,
      vcodec: 'h264',
      width: 320,
      height: 240,
    }),
  )
else {
  const out = args[args.indexOf('-o') + 1]!.replace('%(ext)s', 'mp4')
  if (expired && info >= 0) {
    await Bun.sleep(4000)
    console.error('ERROR: unable to download video data: HTTP Error 403: Forbidden')
    process.exit(1)
  }
  if (url.includes('ffmpeg')) {
    writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
    const child = url.includes('stubborn') ? ['sh', '-c', "trap '' TERM; exec sleep 20"] : ['sleep', '20']
    await Bun.spawn(child, { stdout: 'inherit', stderr: 'inherit' }).exited
  }
  if (url.includes('linger'))
    Bun.spawn(['sh', '-c', `log="$LINGER/$V.$$"; trap 'echo TERM >> "$log"; exit' TERM; echo up >> "$log"; sleep 15 & wait; echo done >> "$log"`], {
      env: { ...process.env, V: new URL(url).searchParams.get('v')! },
      stdio: ['ignore', 'ignore', 'ignore'],
    }).unref()
  // MB on disk without writing them
  const sparse = (path: string, mb: number) => {
    writeFileSync(path, '')
    truncateSync(path, mb * 2 ** 20)
  }
  if (url.includes('endless')) {
    // before the file is too big: a stop would miss a child forked as it comes
    const child = Bun.spawn(['sleep', '20'], { stdout: 'inherit', stderr: 'inherit' })
    if (process.env.LINGER)
      Bun.spawn(['sh', '-c', `log="$LINGER/$V.$$"; trap '' TERM; echo up >> "$log"; sleep 7; echo done >> "$log"`], {
        env: { ...process.env, V: new URL(url).searchParams.get('v')! },
        stdio: ['ignore', 'ignore', 'ignore'],
      }).unref()
    writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
    await Bun.sleep(500)
    sparse(`${out}.part`, 2001)
    await child.exited
    renameSync(`${out}.part`, out)
    console.log(out)
    process.exit(0)
  }
  if (url.includes('parts')) {
    const at = (name: string) => join(dirname(out), name)
    sparse(at('v.f137.mp4'), 1900)
    sparse(at('v.f140.m4a'), 100)
    sparse(at('v.temp.mp4'), 2000)
    await Bun.sleep(500)
    renameSync(at('v.temp.mp4'), out)
    await Bun.sleep(500)
    for (const f of [at('v.f137.mp4'), at('v.f140.m4a'), out]) rmSync(f)
  }
  if (crawl) writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
  await Bun.sleep(crawl ? 9000 : long ? 3000 : 200)
  if (url.includes('broken')) {
    writeFileSync(`${out}.part`, new Uint8Array(3 * 2 ** 20))
    console.error('ERROR: unable to download video data: HTTP Error 403: Forbidden')
    process.exit(1)
  }
  if (url.includes('huge')) {
    writeFileSync(`${out}.part`, new Uint8Array(3 * 2 ** 20))
    process.exit(0)
  }
  rmSync(`${out}.part`, { force: true })
  copyFileSync(process.env.FAKE_MP4!, out)
  console.log(out)
}
