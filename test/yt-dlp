#!/usr/bin/env bun
// Stands in for yt-dlp in bot.e2e.test.ts: --list-extractors lists every link
// under the generic extractor and a YouTube one under youtube too, -J finds
// no video on a page off YouTube (an article) and describes a YouTube link
// (one with "long" in it is a 50-minute video, one with "slow" takes 3 s to
// describe, one with "fail" is unavailable, one with "tweet" is a tweet without a video,
// one with "news" is a news article without media, which BBC's or CNN's
// extractor tells as a playlist with no entries,
// one with "reel" in it is an Instagram reel and one with "stream" in it a
// stream, neither saying how long it is; the video's id is the v= parameter,
// the format it picks "a", or "b" for one with "swap" in it when the page has
// been read before, or with "flip" in it from the page's 4th read on, by a -J
// or a download from the page itself, as listed in $PAGES/<id>; the format's
// link, signed anew in its query on every read, ends in its letter, and its
// id is that letter too; one with "embed" in it is a generic page's <video>
// as yt-dlp tells one, a format "0" that says nothing else, whose link picks
// the clip by its query, clip=<letter>; one with "multi" in it is a post with
// several videos, a playlist of its first one, as -J --playlist-items 1 tells
// it, whose saved info a download reads the page again from, as yt-dlp does
// with no entries to download (it drops them from saved info); one with
// "stuck" in it takes 30 s to describe when the page has been read before; a
// page read before with next=<id> in its link picks another video instead (a
// post's first one, with "multi"): 40 s of audio titled "Next", by
// "Someone", at its own link with v=<id>, live now if <id> has "live" in it
// and 3000 MB if "big"), a download copies FAKE_MP4 after a while
// (one with "crawl" in it takes 9 s, with 2 MB of it on disk meanwhile; one
// with "broken" in it stops partway, 3 MB in; one with "huge" in it stops 3 MB
// in without a word, as at --max-filesize; one with "expired" in it fails after
// 4 s the first time in a job's dir, from the saved info, as an expired media
// link would, and crawls the next time, from the page read again; one with
// "cut" in it writes 5 MB instead, FAKE_MP4 and then its format's letter,
// but the first time in a job's dir fails 3 MB in (2 MB with "swap" in it),
// and goes on from the bytes a v.mp4.part already has whatever format they
// are, as yt-dlp's --continue does, noted in $PAGES/<id>; one with "linger"
// in it first leaves a process in its group that
// doesn't hold its output and outlives it by 15 s, writing "up", then "done"
// or "TERM" if it got SIGTERM, to $LINGER/<id>.<its pid>, or with "deaf" in it
// too one that ignores SIGTERM, writes "up" there and never ends by itself
// (such a process lives until the test is over, its $GATES dir gone, or
// about a minute: meanwhile only a signal it doesn't ignore stops it); one with
// "ffmpeg" in it, 2 MB in, waits for a child that has its stdout and stderr
// and never ends by itself, as yt-dlp waits for the ffmpeg it hands m3u8 to,
// a child that ignores SIGTERM when "stubborn" is in it too (with $LINGER
// set, its pid goes to $LINGER/<id>.pid), and one in a session of its own,
// out of yt-dlp's process group, when "escape" is; one with "endless" in it,
// as an HLS stream of unknown size, starts a child that has its stdout and
// stderr (as ffmpeg would) and never ends by itself, in a session of its own
// when "escape" is in it too, has 2 MB, then after 0.5 s 2001 MB (a sparse
// file), and is done with that file when the child is; with $LINGER set it
// also leaves a process in its group that ignores SIGTERM, doesn't hold its
// output, writes "up" to $LINGER/<id>.<its pid> and never ends by itself:
// only a SIGKILL stops it before the test is over, and the file passes 2000
// MB only once it has written "up"; one with "parts" in it has a merge on
// disk for 1 s, 1900 and 100 MB parts and their 2000 MB merged copy,
// v.temp.mp4 at first and v.mp4 from 0.5 s on, as a merge renames it before
// the parts go)
import {
  appendFileSync,
  copyFileSync,
  existsSync,
  readFileSync,
  renameSync,
  rmSync,
  statSync,
  truncateSync,
  writeFileSync,
} from 'node:fs'
import { dirname, join } from 'node:path'

// FAKE_SCALE scales every wait below but `forever`'s (bot.e2e.test.ts halves them for its time limit tests)
const SCALE = Number(process.env.FAKE_SCALE) || 1
const sleep = (ms: number) => Bun.sleep(ms * SCALE)
const args = process.argv.slice(2)
// A self-update works, unless $UPDATES is set: then each try adds a line to
// that file and fails as yt-dlp's does once GitHub's API limit is used up
if (args.includes('--update-to') && process.env.UPDATES) {
  appendFileSync(process.env.UPDATES, 'try\n')
  console.error(
    'ERROR: Unable to obtain version info (HTTP Error 403: rate limit exceeded); Please try again later or visit  https://github.com/yt-dlp/yt-dlp-nightly-builds/releases/latest',
  )
  process.exit(100)
}
if (args.includes('--update-to')) process.exit(0)
const youtube = (link: string) => /^(www\.)?(youtube\.com|youtu\.be)$/.test(new URL(link).hostname)
if (args.includes('--list-extractors')) {
  // each extractor's name, then the links it claims, as yt-dlp prints them
  const links = args.slice(args.indexOf('--') + 1)
  for (const link of links) if (link.includes('lhold')) await hold(new URL(link).searchParams.get('v')!, 'L')
  const list = (ie: string, claimed: string[]) => [ie, ...claimed.map((link) => `  ${link}`)]
  console.log([...list('generic', links), ...list('youtube', links.filter(youtube))].join('\n'))
  process.exit(0)
}
const info = args.indexOf('--load-info-json')
const loaded = info >= 0 ? JSON.parse(readFileSync(args[info + 1]!, 'utf8')) : undefined
// a playlist's saved info has nothing to download but its page
const saved = loaded?._type === 'playlist' ? undefined : loaded
const url: string = loaded ? loaded.webpage_url : args.findLast((a) => a.startsWith('https://'))!
if (args.includes('-J') && !youtube(url)) {
  console.error(`ERROR: Unsupported URL: ${url}`)
  process.exit(1)
}
const id = new URL(url).searchParams.get('v')!
const long = url.includes('long')
const reel = url.includes('reel')
const lengthless = reel || url.includes('stream')
// one with "jhold" in it holds its -J (whether or not it finds a video), one
// with "dhold" its download and one with "lhold" its check (--list-extractors,
// above), until the test releases it ($GATES/<id>.J, .dl or .L appears;
// <id>.J.held says it's held): no timing to race
async function hold(v: string, what: 'J' | 'dl' | 'L') {
  const gates = process.env.GATES!
  writeFileSync(join(gates, `${v}.${what}.held`), '')
  while (!existsSync(join(gates, `${v}.${what}`))) {
    // the test is over (a killed bot leaves this run behind)
    if (!existsSync(gates)) process.exit(1)
    await Bun.sleep(20)
  }
}
if (args.includes('-J')) {
  if (url.includes('jhold')) await hold(id, 'J')
} else if (url.includes('dhold')) await hold(id, 'dl')
if (args.includes('-J') && url.includes('fail')) {
  console.error('ERROR: [youtube] x: Video unavailable')
  process.exit(1)
}
if (args.includes('-J') && url.includes('tweet')) {
  console.error('ERROR: [twitter] 123: No video could be found in this tweet')
  process.exit(1)
}
if (args.includes('-J') && url.includes('news')) {
  console.log(JSON.stringify({ _type: 'playlist', id, extractor_key: 'BBC', title: 'Article', webpage_url: url, entries: [] }))
  process.exit(0)
}
const pages = process.env.PAGES
const log = pages ? join(pages, id) : undefined
// how many times the page has been read before
const reads = log && existsSync(log) ? readFileSync(log, 'utf8').split('\n').filter((l) => l === 'read').length : 0
const before = reads > 0
// The page read: the letter of the format it picks
function read() {
  if (log) appendFileSync(log, 'read\n')
  return (url.includes('swap') && before) || (url.includes('flip') && reads >= 3) ? 'b' : 'a'
}
if (args.includes('-J') && url.includes('slow')) await sleep(3000)
if (args.includes('-J') && url.includes('stuck') && before) await sleep(30_000)
const next = new URL(url).searchParams.get('next')
if (args.includes('-J')) {
  const letter = read()
  const embed = url.includes('embed')
  const multi = url.includes('multi')
  const video = {
    id,
    extractor_key: embed ? 'HTML5MediaEmbed' : reel ? 'Instagram' : multi ? 'Twitter' : 'Youtube',
    title: 'Video',
    webpage_url: url,
    format_id: embed ? '0' : letter,
    url: embed
      ? `https://media.example/${id}/video.mp4?clip=${letter}`
      : `https://media.example/${id}/${letter}.mp4?sig=${Math.random().toString(36).slice(2)}`,
    ext: 'mp4',
    protocol: 'https',
    duration: lengthless ? undefined : long ? 3000 : 30,
    ...(embed ? {} : { vcodec: 'h264', width: 320, height: 240 }),
  }
  const shown =
    next && before
      ? {
          id: next,
          extractor_key: 'Youtube',
          title: 'Next',
          uploader: 'Someone',
          webpage_url: `https://www.youtube.com/watch?v=${next}`,
          format_id: 'a',
          url: `https://media.example/${next}/a.m4a`,
          ext: 'm4a',
          protocol: 'https',
          duration: 40,
          vcodec: 'none',
          live_status: next.includes('live') ? 'is_live' : 'not_live',
          filesize: next.includes('big') ? 3000 * 2 ** 20 : undefined,
        }
      : video
  console.log(
    JSON.stringify(
      multi
        ? { _type: 'playlist', id, extractor_key: embed ? 'Generic' : 'Twitter', title: 'Post', webpage_url: url, entries: [shown] }
        : shown,
    ),
  )
} else {
  const out = args[args.indexOf('-o') + 1]!.replace('%(ext)s', 'mp4')
  // the job's first download leaves a mark in its dir
  const mark = join(dirname(out), 'fake-tried')
  const first = !existsSync(mark)
  writeFileSync(mark, '')
  const expired = url.includes('expired')
  if (expired && first) {
    await sleep(4000)
    console.error('ERROR: unable to download video data: HTTP Error 403: Forbidden')
    process.exit(1)
  }
  if (url.includes('cut')) {
    // the format's letter: the clip its link picks, or its file's name
    const media = saved && new URL(saved.url)
    const letter = (media ? (media.searchParams.get('clip') ?? media.pathname.split('/').pop()![0]!) : read()).charCodeAt(0)
    // the format's 5 MB: FAKE_MP4, which the bot takes its thumbnail from,
    // then its letter
    const whole = new Uint8Array(5 * 2 ** 20).fill(letter)
    whole.set(readFileSync(process.env.FAKE_MP4!))
    const part = `${out}.part`
    if (first) {
      writeFileSync(part, whole.subarray(0, (url.includes('swap') ? 2 : 3) * 2 ** 20))
      console.error('ERROR: unable to download video data: HTTP Error 403: Forbidden')
      process.exit(1)
    }
    const have = existsSync(part) ? statSync(part).size : 0
    if (have && pages) appendFileSync(join(pages, id), `resumed ${have}\n`)
    appendFileSync(part, whole.subarray(have))
    renameSync(part, out)
    console.log(out)
    process.exit(0)
  }
  const crawl = url.includes('crawl') || (expired && !first)
  // a child's shell that never ends by itself while the test runs: it lives
  // until the test is over (the harness removes $GATES), or about a minute if
  // the test never got to that, so a test sees whatever ended it before then,
  // and no time it would have taken to end can race that
  const forever = 'i=0; while [ -d "$GATES" ] && [ $i -lt 600 ]; do sleep 0.1; i=$((i + 1)); done'
  if (url.includes('linger')) {
    const lives = url.includes('deaf')
      ? `trap '' TERM; echo up >> "$log"; ${forever}`
      : `trap 'echo TERM >> "$log"; exit' TERM; echo up >> "$log"; sleep ${15 * SCALE} & wait; echo done >> "$log"`
    Bun.spawn(['sh', '-c', `log="$LINGER/$V.$$"; ${lives}`], {
      env: { ...process.env, V: new URL(url).searchParams.get('v')! },
      stdio: ['ignore', 'ignore', 'ignore'],
    }).unref()
  }
  if (url.includes('ffmpeg')) {
    writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
    const child = url.includes('stubborn')
      ? ['sh', '-c', `[ -n "$LINGER" ] && echo $$ > "$LINGER/$V.pid"; trap '' TERM; ${forever}`]
      : ['sh', '-c', forever]
    await Bun.spawn(child, {
      env: { ...process.env, V: new URL(url).searchParams.get('v')! },
      stdout: 'inherit',
      stderr: 'inherit',
      detached: url.includes('escape'),
    }).exited
  }
  // MB on disk without writing them
  const sparse = (path: string, mb: number) => {
    writeFileSync(path, '')
    truncateSync(path, mb * 2 ** 20)
  }
  if (url.includes('endless')) {
    // before the file is too big: a stop would miss a child forked as it comes
    const child = Bun.spawn(['sh', '-c', forever], { stdout: 'inherit', stderr: 'inherit', detached: url.includes('escape') })
    const linger = process.env.LINGER
      ? Bun.spawn(['sh', '-c', `log="$LINGER/$V.$$"; trap '' TERM; echo up >> "$log"; ${forever}`], {
          env: { ...process.env, V: new URL(url).searchParams.get('v')! },
          stdio: ['ignore', 'ignore', 'ignore'],
        })
      : undefined
    linger?.unref()
    writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
    await sleep(500)
    // and too big only once that process has written "up" (its trap is set
    // by then): a stop before that, as a loaded machine may start the sh
    // late, would kill it before it wrote a thing, by the SIGTERM if its trap
    // isn't set yet, or else by the SIGKILL as the run ends (#453)
    if (linger) {
      const up = join(process.env.LINGER!, `${id}.${linger.pid}`)
      while (!statSync(up, { throwIfNoEntry: false })?.size) {
        // the test is over (a killed bot leaves this run behind)
        if (!existsSync(process.env.GATES!)) process.exit(1)
        await Bun.sleep(10)
      }
    }
    sparse(`${out}.part`, 2001)
    await child.exited
    renameSync(`${out}.part`, out)
    console.log(out)
    process.exit(0)
  }
  if (url.includes('parts')) {
    const at = (name: string) => join(dirname(out), name)
    sparse(at('v.f137.mp4'), 1900)
    sparse(at('v.f140.m4a'), 100)
    sparse(at('v.temp.mp4'), 2000)
    await sleep(500)
    renameSync(at('v.temp.mp4'), out)
    await sleep(500)
    for (const f of [at('v.f137.mp4'), at('v.f140.m4a'), out]) rmSync(f)
  }
  if (crawl) writeFileSync(`${out}.part`, new Uint8Array(2 * 2 ** 20))
  // a held download took its time already
  if (!url.includes('dhold')) await sleep(crawl ? 9000 : long ? 3000 : 200)
  if (url.includes('broken')) {
    writeFileSync(`${out}.part`, new Uint8Array(3 * 2 ** 20))
    console.error('ERROR: unable to download video data: HTTP Error 403: Forbidden')
    process.exit(1)
  }
  if (url.includes('huge')) {
    writeFileSync(`${out}.part`, new Uint8Array(3 * 2 ** 20))
    process.exit(0)
  }
  rmSync(`${out}.part`, { force: true })
  copyFileSync(process.env.FAKE_MP4!, out)
  console.log(out)
}
